{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      { "source": "/pcn-app", "destination": "/theclub", "type": 301 },
      { "source": "/pcn-app.html", "destination": "/theclub", "type": 301 },
      { "source": "/podcast", "destination": "/living-with-parkinsons-podcast", "type": 301 },
      { "source": "/podcast/**", "destination": "/living-with-parkinsons-podcast", "type": 301 }
    ],
    "rewrites": [
      { "source": "/exchange/provider/**/claim", "destination": "/exchange-claim.html" },
      { "source": "/exchange/provider/**", "destination": "/exchange-provider.html" },
      { "source": "/exchange/location/**", "destination": "/exchange-location.html" },
      { "source": "/exchange/category/**", "destination": "/exchange-category.html" },
      { "source": "/api/provider/signup", "function": "providerSignup" },
      { "source": "/api/provider/signin", "function": "providerSignin" },
      { "source": "/api/provider/create", "function": "providerCreate" },
      { "source": "/api/provider/claim", "function": "providerClaim" },
      { "source": "/api/provider/dashboard", "function": "providerDashboard" },
      { "source": "/api/provider/update", "function": "providerUpdate" },
      { "source": "/api/provider/club-sync", "function": "providerClubSync" },
      { "source": "/api/admin/verify", "function": "adminVerify" },
      { "source": "/api/admin/providers", "function": "adminProviders" },
      { "source": "/api/admin/provider/approve", "function": "adminProviderApprove" },
      { "source": "/api/admin/provider/reject", "function": "adminProviderReject" },
      { "source": "/api/admin/provider/flag", "function": "adminProviderFlag" },
      { "source": "/api/admin/high-intent", "function": "adminHighIntent" },
      { "source": "/api/admin/send-reminder", "function": "adminSendReminder" },
      { "source": "/api/admin/conversion-metrics", "function": "adminConversionMetrics" },
      { "source": "/api/admin/owner-dashboard", "function": "adminOwnerDashboard" },
      { "source": "/api/track-provider-event", "function": "trackEvent" },
      { "source": "/api/youtube/latest", "function": "youtubeLatest" },
      { "source": "/api/podcast-feed", "function": "podcastFeed" },
      { "source": "/api/public-config", "function": "publicConfig" },
      { "source": "/api/mailerlite-webhook", "function": "mailerLiteWebhook" },
      { "source": "/api/share-stats", "function": "shareStats" },
      { "source": "/api/track-club-analytics", "function": "trackClubAnalytics" },
      { "source": "/api/track-share", "function": "trackShare" },
      { "source": "/api/waitlist-count", "function": "waitlistCount" },
      { "source": "/api/subscribe", "function": "subscribe" },
      { "source": "/api/contact", "function": "contact" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
