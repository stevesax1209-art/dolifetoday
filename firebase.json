{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      { "source": "/pcn-app", "destination": "/theclub", "type": 301 },
      { "source": "/pcn-app.html", "destination": "/theclub", "type": 301 },
      { "source": "/theclub.html", "destination": "/theclub", "type": 301 }
    ],
    "rewrites": [
      { "source": "/newly-diagnosed", "destination": "/newly-diagnosed.html" },
      { "source": "/symptoms", "destination": "/symptoms.html" },
      { "source": "/medication-treatment", "destination": "/medication-treatment.html" },
      { "source": "/exercise-movement", "destination": "/exercise-movement.html" },
      { "source": "/sleep-fatigue", "destination": "/sleep-fatigue.html" },
      { "source": "/mental-health", "destination": "/mental-health.html" },
      { "source": "/care-partners", "destination": "/care-partners.html" },
      { "source": "/community-support", "destination": "/community-support.html" },
      { "source": "/life-in-motion", "destination": "/life-in-motion.html" },
      { "source": "/theclub", "destination": "/theclub.html" },
      { "source": "/api/podcast-feed", "function": "podcastFeed" },
      { "source": "/api/waitlist-count", "function": "waitlistCount" },
      { "source": "/api/subscribe", "function": "subscribe" },
      { "source": "/api/contact", "function": "contact" }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
