# Environment — never commit real secrets
.env
.env.local
.env.*.local

# Dependencies and local tooling
node_modules/
functions/node_modules/
*.log

# Editor and OS noise
.DS_Store
Thumbs.db

# Office and local temp files
~$*

# Firebase build artifacts
.firebase/

# One-off local snapshots and scraper checkpoints
live-*.html
data/*/checkpoint.json
data/*/modal-debug.png

# Outreach lists (contain provider PII)
data/_outreach/

# Prerendered provider pages (regenerated on deploy)
public/exchange/provider/

# Large media that must NOT be committed (keep in cloud storage instead)
public/Images/*.MOV
public/Images/*.mov
public/Images/*.mp4
public/Images/videos/

